# Copy to .env and fill in. Never commit .env.
# Supabase pooler (:6543) — runtime queries, migrations, loads.
DB_POOLER_URI=postgresql://postgres.<ref>:<password>@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?sslmode=require
# Supabase direct (:5432) — kept for IPv6-capable networks.
DB_DIRECT_URI=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres?sslmode=require
# Shared secret for POST /api/schedule/scrape (x-cron-secret header).
CRON_SECRET=generate-with-openssl-rand-hex-24
# Public frontend origin allowed by CORS (exact match; browser hygiene only —
# scripts/cron are unaffected, the write path is gated by CRON_SECRET).
FRONTEND_URL=https://<vercel-app>.vercel.app
# Backend listen port (Render sets its own).
PORT=3000
# Frontend production API base (Vercel env, points at Render URL).
VITE_API_URL=https://<render-service>.onrender.com
